<!--
Description: plain sitemap urlset maps loc and lastmod onto entries
Expect:      not bozo and version == 'sitemap' and len(entries) == 2 and entries[0]['link'] == 'http://www.example.org/' and entries[0]['changefreq'] == 'monthly' and entries[1]['link'] == 'http://www.example.org/about'
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>http://www.example.org/</loc>
    <lastmod>2005-01-01</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>http://www.example.org/about</loc>
  </url>
</urlset>
